# Text normalization
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# ---------------------------------------------------------------------------
# Git LFS — ACTIVE. Enabled 2026-08-10, before any assets were committed.
#
# Large binaries are stored as pointers; the real files live in LFS. Anyone
# cloning this repo needs git-lfs installed or they get pointer text instead
# of assets:  brew install git-lfs && git lfs install
#
# Adding a new asset type? Add it HERE, before the first file of that type is
# committed. Retrofitting LFS onto files already in history requires rewriting
# history, and until then those files sit in the repo at full size forever.
# ---------------------------------------------------------------------------

# Images
*.png      filter=lfs diff=lfs merge=lfs -text
*.jpg      filter=lfs diff=lfs merge=lfs -text
*.jpeg     filter=lfs diff=lfs merge=lfs -text
*.gif      filter=lfs diff=lfs merge=lfs -text
*.webp     filter=lfs diff=lfs merge=lfs -text
*.tga      filter=lfs diff=lfs merge=lfs -text
*.psd      filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.ase      filter=lfs diff=lfs merge=lfs -text

# Audio
*.wav      filter=lfs diff=lfs merge=lfs -text
*.mp3      filter=lfs diff=lfs merge=lfs -text
*.ogg      filter=lfs diff=lfs merge=lfs -text
*.flac     filter=lfs diff=lfs merge=lfs -text

# 3D
*.blend    filter=lfs diff=lfs merge=lfs -text
*.fbx      filter=lfs diff=lfs merge=lfs -text
*.glb      filter=lfs diff=lfs merge=lfs -text
*.obj      filter=lfs diff=lfs merge=lfs -text
*.bin      filter=lfs diff=lfs merge=lfs -text

# Video
*.mp4      filter=lfs diff=lfs merge=lfs -text
*.webm     filter=lfs diff=lfs merge=lfs -text

# Small binaries — not worth LFS, but never diff or merge them.
*.ttf   binary
*.otf   binary
*.ico   binary

# Engine scene/resource files — hand-merging these corrupts them.
*.tscn   -merge
*.tres   -merge
*.unity  -merge
*.prefab -merge
