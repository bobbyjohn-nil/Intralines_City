# Text normalization
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary assets — never diff or merge these, and never let git mangle them.
# A merge conflict in a .blend or .png is unresolvable; first-one-wins is the only sane policy.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.tga    binary
*.psd    binary
*.aseprite binary
*.wav    binary
*.mp3    binary
*.ogg    binary
*.flac   binary
*.blend  binary
*.fbx    binary
*.glb    binary
*.gltf   binary
*.obj    binary
*.ttf    binary
*.otf    binary
*.mp4    binary
*.webm   binary

# Engine scene/resource files — merging these by hand corrupts them.
*.tscn   -merge
*.tres   -merge
*.unity  -merge
*.prefab -merge

# ---------------------------------------------------------------------------
# Git LFS — enable BEFORE committing large binaries, not after.
#
# Once a big file is in history, removing it means rewriting history. If this
# project is going to hold real art, audio, or 3D assets, turn this on now:
#
#   brew install git-lfs && git lfs install
#
# then uncomment the block below and commit it. Assets committed before LFS is
# enabled stay in history at full size forever.
# ---------------------------------------------------------------------------
# *.png    filter=lfs diff=lfs merge=lfs -text
# *.psd    filter=lfs diff=lfs merge=lfs -text
# *.aseprite filter=lfs diff=lfs merge=lfs -text
# *.wav    filter=lfs diff=lfs merge=lfs -text
# *.ogg    filter=lfs diff=lfs merge=lfs -text
# *.mp3    filter=lfs diff=lfs merge=lfs -text
# *.blend  filter=lfs diff=lfs merge=lfs -text
# *.fbx    filter=lfs diff=lfs merge=lfs -text
# *.glb    filter=lfs diff=lfs merge=lfs -text
# *.mp4    filter=lfs diff=lfs merge=lfs -text
