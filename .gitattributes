# Text normalization
* text=auto eol=lf
*.sh text eol=lf

# ---------------------------------------------------------------------------
# Git LFS — ACTIVE. Enabled before any binary asset was committed.
#
# Anyone cloning needs git-lfs or they get pointer text instead of files:
#   brew install git-lfs && git lfs install
#
# Adding a new binary asset type? Add it HERE, before the first file of that
# type is committed. Retrofitting LFS onto files already in history requires
# rewriting history, and until then they sit in the repo at full size forever.
# ---------------------------------------------------------------------------

*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.webm   filter=lfs diff=lfs merge=lfs -text

# Small binaries — not worth LFS, but never diff or merge them.
*.ico   binary
*.ttf   binary
*.otf   binary

# SVG is source, not a binary — icons are hand-authored and must diff.
*.svg   text
