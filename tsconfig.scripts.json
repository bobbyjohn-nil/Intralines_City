{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "composite": true,
    "types": ["node"],
    "outDir": "dist/tsc-scripts",
    "tsBuildInfoFile": "dist/tsc-scripts/tsconfig.scripts.tsbuildinfo"
  },
  "include": [
    "scripts",
    "src/render/three/modelBudgets.ts",
    "src/render/three/modelManifestTypes.ts"
  ]
}
