{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "composite": true,
    "useDefineForClassFields": true,
    "outDir": "dist/tsc-viewer",
    "tsBuildInfoFile": "dist/tsc-viewer/tsconfig.viewer.tsbuildinfo"
  },
  "include": [
    "studio/viewer",
    "src/render/three/modelBudgets.ts",
    "src/render/three/modelManifest.ts",
    "src/render/three/modelManifestTypes.ts"
  ]
}
