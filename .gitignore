# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Vite / bundler caches
.vite/
.parcel-cache/

# Baked city packs — regenerated by `npm run bake`, too large to track
packs/
*.pack

# KTX2 transcoder — vendored from node_modules/three at build/dev time by
# scripts/vendor-basis.mjs (`npm run vendor:basis`, wired into `dev`/`build`/`viewer`). Never
# commit it: it always matches the installed three.js version and would otherwise re-land as a
# full copy in history on every three.js upgrade.
public/basis/

# Model/texture pipeline output — regenerated by `npm run models` (scripts/models/build.ts) from
# sources in studio/assets/incoming/. Derived, not authored: committing it doubles every asset's
# storage and creates merge conflicts on binaries. CI builds this before `npm run build`; a fresh
# clone has none until the pipeline runs. Sources stay tracked (they're under studio/, not here).
public/assets/

# Test output
coverage/

# vitest browser mode's failure screenshots (src/render/three/*.rendered.test.ts) — regenerated
# per run, never meaningful to diff or commit.
src/render/three/__screenshots__/

# Local state — never commit
.env
.env.local
*.log

# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp

# Claude Code local settings (agents and skills ARE committed)
.claude/settings.local.json

# Git worktrees created for isolated agent runs — full repo copies, never committed
.claude/worktrees/
